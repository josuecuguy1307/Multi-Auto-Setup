# The discovery controller inside the lab network: Docker Desktop does not route a bridge network to the host, so the lab is discovered from inside it.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 iputils-ping procps docker-cli && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pydantic psutil pyyaml httpx zeroconf==0.151.5
# The tools run here, at the network position being tested; the skill scripts run in sandbox containers started through the host's Docker (the socket is mounted
# by lab.py, and the repository is mounted at the SAME path as on the host so the sandbox's bind mounts resolve). Test infrastructure only.
ENV PYTHONDONTWRITEBYTECODE=1
