# Test fixture only: a small Linux box with sshd, a user, python3 and libgomp1 (the OpenMP runtime the llama.cpp CPU builds link). Key arrives via $PUBKEY at start.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server procps libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /opt/envrec \
    && useradd -m -s /bin/bash owner && passwd -l owner \
    && ssh-keygen -A \
    && chown owner /opt/envrec
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
