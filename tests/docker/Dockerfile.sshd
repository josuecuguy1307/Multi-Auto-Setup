# Test fixture only: a small Linux box with sshd, a user, and python3. Key arrives via $PUBKEY at start.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server procps \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /opt/envrec \
    && useradd -m -s /bin/bash josue && passwd -l josue \
    && ssh-keygen -A \
    && chown josue /opt/envrec
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
