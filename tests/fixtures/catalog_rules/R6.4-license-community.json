{
 "rule": "R6.4-license-community",
 "kind": "file",
 "says": "a Meta Llama community license is known and labeled, and its name is recorded",
 "cases": [
  {
   "name": "llama3.1 in the header and the card",
   "facts": {
    "gguf.general.license": "llama3.1",
    "hub.card_license": "llama3.1"
   },
   "expect": {
    "offer_by_default": true,
    "license_name": "Llama 3.1 Community License",
    "license_class": "community-host-run",
    "labels": [
     "~community license (not permissive)"
    ]
   }
  }
 ]
}
