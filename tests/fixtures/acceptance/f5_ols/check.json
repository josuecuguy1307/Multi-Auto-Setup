{"kind": "project_tests", "files": {"test_ols.py": "import csv, io, unittest\nimport ols\nDATA = '''price,ads,sales\n19.68,7.3,138.67\n18.35,6.77,152.8\n15.29,1.45,117.67\n8.54,2.92,179.39\n11.11,3.76,146.49\n11.81,8.3,189.47\n19.24,6.09,145.85\n8.74,6.94,201.51\n18.71,9.8,157.24\n10.41,8.43,186.37\n19.94,6.55,123.2\n18.4,7.25,136.69\n13.07,7.04,159.14\n8.42,9.38,236.65\n17.81,4.02,129.0\n9.52,6.49,199.65\n10.66,8.4,202.53\n16.0,5.19,158.21\n13.73,1.74,118.91\n18.43,1.49,110.75\n16.53,8.03,184.35\n14.49,2.57,119.82\n15.53,1.97,98.99\n18.67,8.96,147.39\n11.23,2.01,137.78\n13.82,2.97,124.66\n15.51,3.97,144.16\n17.99,9.12,175.07\n19.46,8.36,131.72\n12.59,8.93,190.08\n12.91,9.23,200.73\n13.06,5.16,158.2\n10.85,8.89,221.76\n16.96,4.01,103.07\n8.39,3.3,171.56\n17.19,3.77,122.75\n14.25,2.55,119.98\n15.37,4.51,140.48\n9.53,5.11,188.49\n19.02,1.45,80.46\n13.88,7.06,170.54\n19.99,2.55,78.94\n16.09,5.24,149.59\n17.46,2.77,124.49\n17.65,1.25,92.57\n13.88,1.66,135.47\n15.28,7.22,164.39\n18.72,1.26,69.6\n10.31,1.85,158.25\n8.71,5.85,197.09\n8.38,1.22,136.27\n13.43,5.17,154.21\n15.4,2.65,110.9\n12.92,9.44,196.29\n14.1,4.19,155.95\n9.2,1.54,151.88\n8.08,6.93,217.13\n17.68,8.86,198.95\n13.14,6.28,177.46\n14.32,7.61,178.47'''\nEXP = {'coef': [193.267071, -6.35359, 9.648367], 'r2': 0.903158, 'price_significant_5pct': True, 'statsmodels': '0.15.0'}\n\n\nclass T(unittest.TestCase):\n    def setUp(self):\n        rows = list(csv.DictReader(io.StringIO(DATA)))\n        self.out = ols.fit([float(r['price']) for r in rows], [float(r['ads']) for r in rows], [float(r['sales']) for r in rows])\n    def test_coefficients(self):\n        for got, want in zip(self.out['coef'], EXP['coef']):\n            self.assertAlmostEqual(got, want, places=4)\n    def test_r2(self):\n        self.assertAlmostEqual(self.out['r2'], EXP['r2'], places=4)\n    def test_significance(self):\n        self.assertEqual(self.out['price_significant_5pct'], EXP['price_significant_5pct'])\n"}, "pattern": "test_ols.py", "mi